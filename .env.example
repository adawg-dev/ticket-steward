# Secrets for ticket-steward. Lives next to steward.config.ts; parsed into a Secrets object, never loaded into process.env.

# Linear OAuth app client id (used for the app-actor token exchange)
LINEAR_CLIENT_ID=
# Linear OAuth app client secret
LINEAR_CLIENT_SECRET=
# Signing secret for the Linear webhook subscription
LINEAR_WEBHOOK_SECRET=

# Read-only token injected into workspace.fetchUrl to fetch the bare mirror
MIRROR_TOKEN=

# GitLab personal/project access token (when codehost.kind is "gitlab")
GITLAB_TOKEN=
# GitHub token (when codehost.kind is "github")
GITHUB_TOKEN=

# Anthropic API key for the claude-code brain (alternative to CLAUDE_CODE_OAUTH_TOKEN)
ANTHROPIC_API_KEY=
# Gateway alternative for the claude-code brain: base URL of an Anthropic-compatible gateway
# (e.g. https://api.concentrate.ai) plus its key as a bearer token. ANTHROPIC_API_KEY wins if set.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Claude Code OAuth token for the claude-code brain (alternative to ANTHROPIC_API_KEY)
CLAUDE_CODE_OAUTH_TOKEN=

# OpenAI API key for the openai-agents brain
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL for the openai-agents brain
OPENAI_BASE_URL=
