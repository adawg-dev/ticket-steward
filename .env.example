# Secrets for ticket-steward. Lives next to steward.config.ts; parsed into a Secrets object, never loaded into process.env.

# Personal API key of a dedicated Linear user (read, write, create comments, file uploads;
# restricted to the allowlisted teams). Every steward write appears as this user.
LINEAR_API_KEY=
# Signing secret of the workspace webhook (Settings -> API -> Webhooks), Issues events only,
# pointed at <server.publicUrl>/webhooks/linear
LINEAR_WEBHOOK_SECRET=

# Read-only token injected into workspace.fetchUrl to fetch the bare mirror
MIRROR_TOKEN=
# Username sent with MIRROR_TOKEN. Required for a GitLab deploy token (its own username);
# leave empty for access tokens (defaults: oauth2 on GitLab, x-access-token on github.com).
MIRROR_USERNAME=

# GitLab token of the steward's own user (codehost.kind "gitlab"). read_api is enough for enrichment.
# With a greptile block the token needs the api scope (replies to and resolves Greptile threads); read_api otherwise.
GITLAB_TOKEN=
# GitLab webhook at <server.publicUrl>/webhooks/gitlab (merge request, comment and pipeline events) that wakes the Greptile
# fix loop; without it the loop polls every 5 minutes. Signing token (whsec_..., GitLab 19.1+) is preferred; the plain
# secret token (X-Gitlab-Token) also works.
GITLAB_WEBHOOK_SIGNING_TOKEN=
GITLAB_WEBHOOK_SECRET=
# GitHub token (when codehost.kind is "github")
GITHUB_TOKEN=

# Anthropic API key for the claude-code brain (alternative to CLAUDE_CODE_OAUTH_TOKEN)
ANTHROPIC_API_KEY=
# Gateway alternative for the claude-code brain: base URL of an Anthropic-compatible gateway
# (e.g. https://api.concentrate.ai) plus its key as a bearer token. ANTHROPIC_API_KEY wins if set.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Claude Code OAuth token for the claude-code brain (alternative to ANTHROPIC_API_KEY)
CLAUDE_CODE_OAUTH_TOKEN=

# OpenAI API key for the openai-agents brain
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL for the openai-agents brain
OPENAI_BASE_URL=
