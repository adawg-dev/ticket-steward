# The IAM side of the steward on Kubernetes (docs/ops.md, "Running on Kubernetes"). Copy it into your Terraform, set the variables,
# and apply. It registers the cluster's service-account issuer as an OIDC provider and defines two roles, assumed with
# projected tokens (audience sts.amazonaws.com): the dispatcher's, which reads the DEV_ secrets, the Linear app's among
# them; and the run pods' sidecars', which reads the DEV_ secrets except the Linear app's (an explicit deny). A sidecar
# handles what the agent wrote, so a Linear credential must never be within its reach. No access key is created.

variable "cluster_issuer_url" {
  description = "The API server's --service-account-issuer: the public https URL serving /.well-known/openid-configuration and the JWKS, no trailing slash."
  type        = string
}

variable "region" {
  description = "The region of the DEV_ secrets (secrets.region and runtime.aws.region in steward.config.ts)."
  type        = string
}

variable "namespace" {
  description = "The steward's namespace (the chart's release namespace, runtime.namespace)."
  type        = string
  default     = "ticket-steward"
}

data "aws_caller_identity" "current" {}

locals {
  issuer_host = trimprefix(var.cluster_issuer_url, "https://")
}

# AWS fetches the issuer's discovery document and JWKS itself; for an issuer served with a public CA it no longer uses
# the thumbprint, but the provider still takes one.
data "tls_certificate" "cluster_issuer" {
  url = var.cluster_issuer_url
}

resource "aws_iam_openid_connect_provider" "cluster" {
  url             = var.cluster_issuer_url
  client_id_list  = ["sts.amazonaws.com"]
  thumbprint_list = [data.tls_certificate.cluster_issuer.certificates[length(data.tls_certificate.cluster_issuer.certificates) - 1].sha1_fingerprint]
}

# One service account per role: the dispatcher's token cannot assume the run role, and a run pod's cannot assume the
# dispatcher's.
data "aws_iam_policy_document" "trust" {
  for_each = {
    dispatcher = "steward-dispatcher"
    run        = "steward-run"
  }
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.cluster.arn]
    }
    condition {
      test     = "StringEquals"
      variable = "${local.issuer_host}:aud"
      values   = ["sts.amazonaws.com"]
    }
    condition {
      test     = "StringEquals"
      variable = "${local.issuer_host}:sub"
      values   = ["system:serviceaccount:${var.namespace}:${each.value}"]
    }
  }
}

# The dispatcher. The role never writes a secret. Only if the install check in docs/ops.md §1.7 shows
# client-credentials tokens cannot act for the app's seat would the authorization-code fallback need a statement
# allowing "secretsmanager:PutSecretValue" on its one refresh-token secret; that fallback is not built.
resource "aws_iam_role" "steward" {
  name                 = "ticket-steward"
  assume_role_policy   = data.aws_iam_policy_document.trust["dispatcher"].json
  max_session_duration = 3600
}

# The run pods' sidecars (git-init, render-overlay, keyproxy, tools). The agent container has no token at all.
resource "aws_iam_role" "steward_run" {
  name                 = "ticket-steward-run"
  assume_role_policy   = data.aws_iam_policy_document.trust["run"].json
  max_session_duration = 3600
}

locals {
  secret_arn = "arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret"
}

# DEV_* covers the steward's own secrets too, among them the Linear app's DEV_STEWARD_LINEAR_CLIENT_ID and
# DEV_STEWARD_LINEAR_CLIENT_SECRET (docs/ops.md §1.7).
data "aws_iam_policy_document" "dispatcher" {
  statement {
    effect    = "Allow"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = ["${local.secret_arn}:DEV_*"]
  }
  # Doctor's `run role` check asks IAM's policy simulator whether the run role can read the Linear secrets.
  statement {
    effect    = "Allow"
    actions   = ["iam:SimulatePrincipalPolicy"]
    resources = [aws_iam_role.steward_run.arn]
  }
}

resource "aws_iam_role_policy" "dispatcher" {
  name   = "dev-secrets-read"
  role   = aws_iam_role.steward.id
  policy = data.aws_iam_policy_document.dispatcher.json
}

# The same DEV_* read, with the Linear app's secrets explicitly denied: the deny wins over any allow added later.
data "aws_iam_policy_document" "run" {
  statement {
    effect    = "Allow"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = ["${local.secret_arn}:DEV_*"]
  }
  statement {
    effect    = "Deny"
    actions   = ["secretsmanager:*"]
    resources = ["${local.secret_arn}:DEV_STEWARD_LINEAR_*"]
  }
}

resource "aws_iam_role_policy" "run" {
  name   = "dev-secrets-read-without-linear"
  role   = aws_iam_role.steward_run.id
  policy = data.aws_iam_policy_document.run.json
}

# runtime.aws.roleArn in steward.config.ts and aws.roleArn in the chart's values (deploy/helm/values).
output "steward_role_arn" {
  value = aws_iam_role.steward.arn
}

# runtime.aws.runRoleArn in steward.config.ts.
output "steward_run_role_arn" {
  value = aws_iam_role.steward_run.arn
}
