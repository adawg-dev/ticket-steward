# The IAM side of the steward on k3s (docs/ops.md, "Running on k3s"). Copy it into your Terraform, set the variables,
# and apply. It registers the cluster's service-account issuer as an OIDC provider and defines the one role the
# dispatcher and the run pods' sidecars assume with their projected tokens (audience sts.amazonaws.com). The role reads
# the DEV_ secrets and nothing else. No access key is created.

variable "k3s_issuer_url" {
  description = "k3s's --service-account-issuer: the public https URL serving /.well-known/openid-configuration and the JWKS, no trailing slash."
  type        = string
}

variable "region" {
  description = "The region of the DEV_ secrets (secrets.region and runtime.aws.region in steward.config.ts)."
  type        = string
}

variable "namespace" {
  description = "The steward's namespace (deploy/k8s/base/namespace.yaml)."
  type        = string
  default     = "ticket-steward"
}

data "aws_caller_identity" "current" {}

locals {
  issuer_host = trimprefix(var.k3s_issuer_url, "https://")
}

# AWS fetches the issuer's discovery document and JWKS itself; for an issuer served with a public CA it no longer uses
# the thumbprint, but the provider still takes one.
data "tls_certificate" "k3s_issuer" {
  url = var.k3s_issuer_url
}

resource "aws_iam_openid_connect_provider" "k3s" {
  url             = var.k3s_issuer_url
  client_id_list  = ["sts.amazonaws.com"]
  thumbprint_list = [data.tls_certificate.k3s_issuer.certificates[length(data.tls_certificate.k3s_issuer.certificates) - 1].sha1_fingerprint]
}

data "aws_iam_policy_document" "steward_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.k3s.arn]
    }
    condition {
      test     = "StringEquals"
      variable = "${local.issuer_host}:aud"
      values   = ["sts.amazonaws.com"]
    }
    # The dispatcher, and the run pods' sidecars (git-init, render-overlay, keyproxy, tools). The run pods' agent
    # container has no token, so it cannot assume this role.
    condition {
      test     = "StringEquals"
      variable = "${local.issuer_host}:sub"
      values = [
        "system:serviceaccount:${var.namespace}:steward-dispatcher",
        "system:serviceaccount:${var.namespace}:steward-run",
      ]
    }
  }
}

resource "aws_iam_role" "steward" {
  name                 = "ticket-steward"
  assume_role_policy   = data.aws_iam_policy_document.steward_trust.json
  max_session_duration = 3600
}

# DEV_* covers the steward's own secrets too, among them the Linear app's DEV_STEWARD_LINEAR_CLIENT_ID and
# DEV_STEWARD_LINEAR_CLIENT_SECRET (docs/ops.md §1.7). The role never writes a secret. Only if the install check in
# docs/ops.md §1.7 shows client-credentials tokens cannot act for the app's seat would the authorization-code fallback
# need a statement allowing "secretsmanager:PutSecretValue" on its one refresh-token secret; that fallback is not built.
data "aws_iam_policy_document" "dev_secrets" {
  statement {
    effect    = "Allow"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = ["arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:DEV_*"]
  }
}

resource "aws_iam_role_policy" "dev_secrets" {
  name   = "dev-secrets-read"
  role   = aws_iam_role.steward.id
  policy = data.aws_iam_policy_document.dev_secrets.json
}

# runtime.aws.roleArn in steward.config.ts and awsRoleArn in deploy/k8s/base/kustomization.yaml.
output "steward_role_arn" {
  value = aws_iam_role.steward.arn
}
