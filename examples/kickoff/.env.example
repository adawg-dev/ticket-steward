# Secrets for the kickoff steward. Copy to .env next to steward.config.ts (mode 0600).
# The steward parses this file into memory; nothing here is exported to process.env
# or forwarded to the brain except the one brain credential.

# The steward's Linear OAuth app (client-credentials grant, installed with actor=app). On AWS these are
# Secrets Manager DEV_STEWARD_LINEAR_CLIENT_ID and DEV_STEWARD_LINEAR_CLIENT_SECRET.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Signing secret of the webhook created under Settings -> API -> Webhooks at
# <server.publicUrl>/webhooks/linear, Issues data-change events only.
LINEAR_WEBHOOK_SECRET=

# Read-only GitLab deploy token (scope: read_repository) for concentrateai/kickoff.
# Injected into workspace.fetchUrl as https://<MIRROR_USERNAME>:<token>@gitlab.com/... when the
# mirror is created or fetched. Never a personal token with write access.
MIRROR_TOKEN=
# The deploy token's username (GitLab rejects a deploy token sent with any other username).
MIRROR_USERNAME=

# GitLab token of the steward's own user (codehost.kind "gitlab"). read_api is enough to read merge requests; the Greptile loop needs api.
# Reaches only the codehost MCP server and the steward's own GitLab calls, never the brain itself.
# With a greptile block the token needs the api scope (replies to and resolves Greptile threads); read_api otherwise.
GITLAB_TOKEN=
# GitLab webhook at <server.publicUrl>/webhooks/gitlab (merge request, comment and pipeline events) that wakes the Greptile
# fix loop; without it the loop polls every 5 minutes. Signing token (whsec_..., GitLab 19.1+) is preferred; the plain
# secret token (X-Gitlab-Token) also works.
GITLAB_WEBHOOK_SIGNING_TOKEN=
GITLAB_WEBHOOK_SECRET=
# GitHub fine-grained token with contents:read and pull_requests:read
# (only when codehost.kind is "github").
GITHUB_TOKEN=

# Brain credential for kind "claude-code": exactly one of the two. ANTHROPIC_API_KEY wins
# when both are set. Mint the OAuth token with `claude setup-token` as the steward user.
ANTHROPIC_API_KEY=
# Gateway alternative for the claude-code brain: base URL of an Anthropic-compatible gateway
# (e.g. https://api.concentrate.ai) plus its key as a bearer token. ANTHROPIC_API_KEY wins if set.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=

# Brain credential for kind "openai-agents".
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (gateway or proxy).
OPENAI_BASE_URL=
