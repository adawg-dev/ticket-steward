# Interpolation values for compose.yaml; copy to ops/compose.env and pass --env-file ops/compose.env.
# No secrets here: the steward reads them from the .env in STEWARD_CONFIG_DIR.

# Host port for webhooks and /health, bound to 127.0.0.1 (the tunnel points here).
STEWARD_PORT=3020
# The uid/gid the steward runs as and the slot socket belongs to; on the live host the existing steward user (998).
STEWARD_UID=1001
STEWARD_GID=1001
# Bind-mounted read-only (config, .env, overlay, prompts, skills) and read-write (DB, mirror, worktrees, sessions).
STEWARD_CONFIG_DIR=/etc/ticket-steward
STEWARD_DATA_DIR=/var/lib/ticket-steward
